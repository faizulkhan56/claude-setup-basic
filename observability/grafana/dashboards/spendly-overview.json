      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
      "targets": [{"refId": "A", "expr": "probe_success{job=\"spendly-blackbox\",target=\"ready\"}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "NOT READY"}, "1": {"text": "READY"}}}]}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
